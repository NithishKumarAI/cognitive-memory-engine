# Examples live in backend/.env.example and frontend/.env.example.
# Backend loads backend/.env when started from backend/.
# Next.js loads frontend/.env.local. NEXT_PUBLIC_* values are public build inputs.
# Test-only opt-ins: use an isolated, disposable PostgreSQL + pgvector instance.
# PHASE1_TEST_DATABASE_URL=postgresql+psycopg://phase1:test-only@127.0.0.1:5432/cme_phase1_test
# PHASE4_E2E_DATABASE_URL=postgresql+psycopg://phase1:test-only@127.0.0.1:5432/cme_phase1_test
