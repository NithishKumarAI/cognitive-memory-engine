# Local development only. Copy to backend/.env; never commit real values.
DATABASE_URL=postgresql+psycopg://cme_dev:replace-me@127.0.0.1:5432/cme_dev
# Explicit migration target; never inferred from DATABASE_URL. Use the same NEW local dev database.
ALEMBIC_DATABASE_URL=postgresql+psycopg://cme_dev:replace-me@127.0.0.1:5432/cme_dev
SECRET_KEY=replace-with-your-own-random-secret-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
APP_EDITION=product
# Comma-separated Fernet keys from your secret manager; newest first. Never expose publicly.
AI_KEY_ENCRYPTION_KEYS=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=30000
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Operational switches: not quotas/rate limits. Set both false before an unverified release.
REGISTRATION_ENABLED=true
# Start with cloud AI off; enable only after configuring your own key and cost controls.
AI_ENABLED=false
