# Separate, disposable demo deployment. Never reuse a product database or signing key.
APP_EDITION=demo
DEMO_STORAGE_ENABLED=true
DATABASE_URL=postgresql+psycopg://demo_role:replace-me@127.0.0.1:5432/learntrack_demo
ALEMBIC_DATABASE_URL=postgresql+psycopg://demo_role:replace-me@127.0.0.1:5432/learntrack_demo
SECRET_KEY=replace-with-unused-product-mode-signing-secret
DEMO_SECRET_KEY=replace-with-distinct-demo-secret-at-least-32-characters
REGISTRATION_ENABLED=false
AI_ENABLED=false
FRONTEND_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# No Gemini key is read in demo mode. All live providers are blocked in code.
